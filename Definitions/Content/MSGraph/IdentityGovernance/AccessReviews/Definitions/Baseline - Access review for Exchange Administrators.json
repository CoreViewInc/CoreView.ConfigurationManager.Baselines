{
  "displayName": "Baseline - Access review for Exchange Administrators",
  "additionalNotificationRecipients": [],
  "backupReviewers": [],
  "descriptionForAdmins": "",
  "descriptionForReviewers": "",
  "fallbackReviewers": [],
  "reviewers": [
    {
      "query": "/v1.0/users/${urn:resource:MSGraph:Users/admin@${ResourceContext:TenantDomainName}?id}",
      "queryType": "MicrosoftGraph"
    }
  ],
  "scope": {
    "principalScopes": [
      {
        "query": "/v1.0/groups",
        "queryType": "MicrosoftGraph"
      },
      {
        "query": "/v1.0/users",
        "queryType": "MicrosoftGraph"
      }
    ],
    "resourceScopes": [
      {
        "query": "/beta/roleManagement/directory/roleDefinitions/${urn:resource:MSGraph:RoleManagement:Directory:RoleDefinitions/Exchange Administrator?id}",
        "queryType": "MicrosoftGraph"
      }
    ]
  },
  "settings": {
    "applyActions": [
      {}
    ],
    "autoApplyDecisionsEnabled": true,
    "decisionHistoriesForReviewersEnabled": false,
    "defaultDecision": "None",
    "defaultDecisionEnabled": false,
    "instanceDurationInDays": 14,
    "justificationRequiredOnApproval": true,
    "mailNotificationsEnabled": true,
    "recommendationInsightSettings": [
      {
        "recommendationLookBackDuration": "P30D",
        "signInScope": "tenant"
      }
    ],
    "recommendationsEnabled": true,
    "recurrence": {
      "pattern": {
        "dayOfMonth": 0,
        "daysOfWeek": [],
        "firstDayOfWeek": "sunday",
        "index": "first",
        "interval": 1,
        "month": 0,
        "type": "weekly"
      },
      "range": {
        "endDate": "9999-12-31",
        "numberOfOccurrences": 0,
        "type": "noEnd"
      }
    },
    "reminderNotificationsEnabled": true
  },
  "stageSettings": []
}
